# node_modules is installed inside the image (see Dockerfile_CELERY_WORKER);
# a local copy must not leak into the build context and overwrite it.
**/node_modules

# Same for the Python environment (uv sync creates it inside the image).
**/.venv

# And for the ad-blocking cache: the build makes a fresh one (see src/adblocker.js).
**/adblocker-engine.bin

# Secrets come from environment variables (Fly secrets), never from the image.
**/.env
**/config.toml
